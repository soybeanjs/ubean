{
  "name": "ubean-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "pnpm --filter ubean-test analyze",
    "analyze:check": "pnpm --filter ubean-test analyze:check",
    "benchmark:fixture": "node scripts/bench-medium-fixture.mjs",
    "benchmark:lifecycle": "node scripts/benchmark-lifecycle.mjs",
    "benchmark:lifecycle:baseline": "node scripts/benchmark-lifecycle.mjs --out examples/ubean-test/benchmarks/perf-baseline.json",
    "benchmark:ssg": "node scripts/benchmark-ssg.mjs",
    "benchmark:ssr": "node scripts/benchmark-ssr.mjs",
    "build": "pnpm -F './packages/*' --parallel build",
    "build:docs": "pnpm build && pnpm --filter @ubean/docs build",
    "commit": "soy git-commit",
    "dev": "pnpm --filter ubean dev",
    "dev:docs": "pnpm --filter @ubean/docs dev",
    "fmt": "vp fmt",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:stamp": "node scripts/i18n-stamp.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "lint": "vp lint && pnpm lint:vue",
    "lint:fix": "vp lint --fix && pnpm lint:vue --fix",
    "lint:vue": "eslint . --ext .vue",
    "prepare": "vp config --no-hooks --no-agent",
    "release": "soy release",
    "test": "pnpm -r test",
    "test:build": "UBEAN_TEST_MODE=build pnpm --filter ubean-test test",
    "test:e2e": "vp test",
    "test:watch": "pnpm -r test:watch",
    "typecheck": "pnpm build && pnpm typecheck-only",
    "typecheck-only": "pnpm -r --parallel typecheck",
    "upkg": "ncu -u -w"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.4",
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.6.4",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.12.0",
    "miniflare": "^4.20250214.0",
    "vite-plus": "catalog:",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
