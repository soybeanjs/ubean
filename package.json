{
  "name": "ubean-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "pnpm --filter ubean-test analyze",
    "analyze:check": "pnpm --filter ubean-test analyze:check",
    "benchmark:ssg": "node scripts/benchmark-ssg.mjs",
    "build": "pnpm -F './packages/*' --parallel build",
    "commit": "soy git-commit",
    "dev": "pnpm --filter ubean dev",
    "fmt": "vp fmt",
    "lint": "vp lint && pnpm lint:vue",
    "lint:fix": "vp lint --fix && pnpm lint:vue --fix",
    "lint:vue": "eslint . --ext .vue",
    "prepare": "vp config --no-hooks --no-agent",
    "release": "soy release",
    "test": "pnpm -r --parallel test -- --passWithNoTests",
    "test:watch": "pnpm -r --parallel test:watch -- --passWithNoTests",
    "typecheck": "pnpm build && pnpm typecheck-only",
    "typecheck-only": "pnpm -r --parallel typecheck",
    "upkg": "ncu -u -w"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.2",
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.5.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.10.0",
    "vite-plus": "0.3.0",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
