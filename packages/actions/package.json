{
  "name": "@ubean/actions",
  "version": "0.1.13",
  "description": "Server Actions / Form Actions for ubean (defineAction, registry, dispatch, middleware)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/types": "workspace:*",
    "@ubean/utils": "workspace:*",
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
