{
  "name": "@ubean/app",
  "version": "0.3.7",
  "description": "Hono app factory and server config for ubean (createUbeanApp, defineServer)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/i18n": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/routes": "workspace:*",
    "@ubean/scan": "workspace:*",
    "@ubean/server": "workspace:*",
    "@ubean/shared": "workspace:*",
    "hono": "4.13.5",
    "hookable": "^6.1.1",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@ubean/pages": "workspace:*",
    "@ubean/seo": "workspace:*",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/pages": "workspace:*",
    "@ubean/seo": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ubean/pages": {
      "optional": true
    },
    "@ubean/seo": {
      "optional": true
    }
  }
