{
  "name": "@ubean/app",
  "version": "0.0.1",
  "description": "Hono app factory and server config for ubean (createUbeanApp, defineServer)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/api-routes": "workspace:*",
    "@ubean/error": "workspace:*",
    "@ubean/server-runtime": "workspace:*",
    "@ubean/types": "workspace:*",
    "hono": "4.12.31",
    "hookable": "^6.1.1",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@ubean/pages": "workspace:*",
    "@ubean/routing": "workspace:*",
    "typescript": "6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/pages": "workspace:*",
    "@ubean/routing": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ubean/routing": {
      "optional": true
    },
    "@ubean/pages": {
      "optional": true
    }
  }
}
