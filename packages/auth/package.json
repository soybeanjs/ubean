{
  "name": "@ubean/auth",
  "version": "0.1.7",
  "description": "Better Auth integration for ubean framework",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "consola": "^3.4.2",
    "defu": "6.1.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "hono": "4.12.32",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vite": "^5.0.0 || ^6.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "optionalDependencies": {}
}
