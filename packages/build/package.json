{
  "name": "@ubean/build",
  "version": "0.1.0",
  "description": "Core Vite plugin (framework-agnostic) for ubean (ubeanPlugin, virtual modules: routes/pages/meta/app-config/locales, macros)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "import": "./dist/production.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/config": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/modules": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/routing": "workspace:*",
    "@ubean/ssr": "workspace:*",
    "@ubean/utils": "workspace:*",
    "@ubean/vite": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "consola": "^3.4.2",
    "oxc-transform": "^0.141.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
