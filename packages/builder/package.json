{
  "name": "@ubean/build",
  "version": "0.3.4",
  "description": "Vite plugins, production build, SSG prerender, type codegen, and Server Actions plugin for ubean",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "import": "./dist/production.js"
    },
    "./prerender": {
      "types": "./dist/prerender.d.ts",
      "import": "./dist/prerender.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    },
    "./actions": {
      "types": "./dist/actions-plugin.d.ts",
      "import": "./dist/actions-plugin.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@ubean/client": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/i18n": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/markdown": "workspace:*",
    "@ubean/pages": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/routes": "workspace:*",
    "@ubean/scan": "workspace:*",
    "@ubean/shared": "workspace:*",
    "@ubean/vue": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "openapi-typescript": "^7.13.0",
    "oxc-transform": "^0.147.0",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17",
    "unimport": "^6.4.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vue-i18n": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "hono": "4.13.5",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
