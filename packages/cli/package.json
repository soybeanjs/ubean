{
  "name": "@ubean/cli",
  "version": "0.3.2",
  "description": "CLI for ubean (ubean-next binary: dev, build, prepare, init, preview, page, env, config, devtools, api/layout/middleware/cron/plugin scaffolds) plus the Vite dev server runner",
  "bin": {
    "ubean-next": "./bin/ubean-next.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/app": "workspace:*",
    "@ubean/build": "workspace:*",
    "@ubean/client": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/scan": "workspace:*",
    "@ubean/shared": "workspace:*",
    "citty": "^0.2.2",
    "kolorist": "^1.8.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/content": "workspace:*",
    "@ubean/devtools": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ubean/content": {
      "optional": true
    },
    "@ubean/devtools": {
      "optional": true
    },
    "@vitejs/plugin-vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
