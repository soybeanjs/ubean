{
  "name": "@ubean/cli",
  "version": "0.1.11",
  "description": "CLI for ubean (ubean-next binary: dev, build, prepare, init, preview, page, env, config, devtools, api/layout/middleware/cron/plugin scaffolds)",
  "bin": {
    "ubean-next": "./bin/ubean-next.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/app": "workspace:*",
    "@ubean/build": "workspace:*",
    "@ubean/codegen": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/dev-server": "workspace:*",
    "@ubean/modules": "workspace:*",
    "@ubean/prerender": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/routing": "workspace:*",
    "@ubean/utils": "workspace:*",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "kolorist": "^1.8.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/devtools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ubean/devtools": {
      "optional": true
    }
  }
}
