{
  "name": "@ubean/client",
  "version": "0.3.0",
  "description": "Framework client runtime for ubean — layered over the lean @ubean/vue kernel, adding app factories, unhead, i18n, data layer, islands hydration and SSR state helpers",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./define-app": {
      "types": "./dist/define-app.d.ts",
      "import": "./dist/define-app.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/i18n": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/pages": "workspace:*",
    "@ubean/shared": "workspace:*",
    "@ubean/vue": "workspace:*",
    "@unhead/vue": "^3.4.0",
    "@vue/server-renderer": "^3.5.41",
    "vue": "^3.5.41",
    "vue-i18n": "catalog:",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/seo": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ubean/seo": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
