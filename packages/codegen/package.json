{
  "name": "@ubean/codegen",
  "version": "0.1.13",
  "description": "Type generation for ubean (generateTypes, routes.d.ts, pages.d.ts, openapi.d.ts)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/auto-imports": "workspace:*",
    "@ubean/routing": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  }
}
