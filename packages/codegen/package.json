{
  "name": "@ubean/codegen",
  "version": "0.1.13",
  "description": "Type & auto-import generation for ubean (generateTypes, routes.d.ts, pages.d.ts, auto-imports.d.ts, components.d.ts, openapi.d.ts)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/scan": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17",
    "unimport": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/scan": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ubean/scan": {
      "optional": true
    }
  }
}
