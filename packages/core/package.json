{
  "name": "@ubean/core",
  "version": "0.0.1",
  "description": "New aggregator package for ubean (re-exports all subpackages, default ubeanPlugin composition, ubean-next CLI)",
  "bin": {
    "ubean-next": "./bin/ubean.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.3.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@ubean/api-routes": "workspace:*",
    "@ubean/app": "workspace:*",
    "@ubean/auto-imports": "workspace:*",
    "@ubean/build": "workspace:*",
    "@ubean/cli": "workspace:*",
    "@ubean/client": "workspace:*",
    "@ubean/codegen": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/dev": "workspace:*",
    "@ubean/devtools": "workspace:*",
    "@ubean/env": "workspace:*",
    "@ubean/error": "workspace:*",
    "@ubean/i18n": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/markdown": "workspace:*",
    "@ubean/modules": "workspace:*",
    "@ubean/pages": "workspace:*",
    "@ubean/prerender": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/routing": "workspace:*",
    "@ubean/runtime": "workspace:*",
    "@ubean/seo": "workspace:*",
    "@ubean/server-runtime": "workspace:*",
    "@ubean/ssr": "workspace:*",
    "@ubean/types": "workspace:*",
    "@ubean/utils": "workspace:*",
    "@ubean/vite": "workspace:*",
    "consola": "^3.4.2",
    "hono": "4.12.31",
    "hono-openapi": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
