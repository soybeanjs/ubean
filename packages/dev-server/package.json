{
  "name": "@ubean/dev-server",
  "version": "0.2.2",
  "description": "Dev server orchestration for ubean (createViteDevServer, createDevRunner, watcher)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/app": "workspace:*",
    "@ubean/build": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/scan": "workspace:*",
    "@ubean/shared": "workspace:*",
    "@ubean/ssr": "workspace:*",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/cli": "workspace:*",
    "@ubean/devtools": "workspace:*",
    "@vitejs/devtools": "^0.x",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ubean/cli": {
      "optional": true
    },
    "@ubean/devtools": {
      "optional": true
    },
    "@vitejs/devtools": {
      "optional": true
    },
    "@vitejs/plugin-vue": {
      "optional": true
    }
  }
}
