{
  "name": "@ubean/devtools",
  "version": "0.6.0-beta.2",
  "description": "DevTools for the ubean framework — server middleware, RPC, and the iframe SPA client",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "vp pack",
    "dev:client": "vite client --config client/vite.config.ts",
    "dev:server": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "hookable": "^6.1.2",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.12",
    "@soybeanjs/ui": "^0.40.1",
    "@soybeanjs/unocss-preset": "^0.2.0",
    "@soybeanjs/unocss-shadcn": "^0.29.3",
    "@types/node": "^26.6.1",
    "@vitejs/devtools": "^0.7.5",
    "@vitejs/devtools-kit": "^0.7.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "4.13.8",
    "typescript": "catalog:",
    "unocss": "^66.10.5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@ai-sdk/openai-compatible": "3.0.52",
    "ai": "7.0.106"
  }
}
