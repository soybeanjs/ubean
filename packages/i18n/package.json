{
  "name": "@ubean/i18n",
  "version": "0.3.2",
  "description": "i18n for ubean (vue-i18n / @intlify/core, compact locale routing, ALS)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@intlify/core": "catalog:",
    "@ubean/shared": "workspace:*",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
