{
  "name": "@ubean/islands",
  "version": "0.3.3",
  "description": "Islands architecture for ubean (Vite plugin for client:load/idle/visible/media/only directives, bootstrap script, client hydrate runtime)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./directive": {
      "types": "./dist/directive.d.ts",
      "import": "./dist/directive.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./server": {
      "types": "./dist/server-component.d.ts",
      "import": "./dist/server-component.js"
    },
    "./virtual-registration": {
      "types": "./dist/virtual-registration.d.ts",
      "import": null
    }
  },
  "scripts": {
    "build": "vp pack && cp src/virtual-registry.d.ts dist/virtual-registry.d.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/shared": "workspace:*",
    "hono": "4.13.5",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
