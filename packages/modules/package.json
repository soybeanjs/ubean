{
  "name": "@ubean/modules",
  "version": "0.0.1",
  "description": "Module system for ubean (resolveModules, defineModule, BUILTIN_MODULES)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/app": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/types": "workspace:*",
    "hookable": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "hono": "4.12.31",
    "typescript": "6.0.3",
    "vite": "^6.0.0 || ^7.0.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    },
    "hono": {
      "optional": false
    }
  }
}
