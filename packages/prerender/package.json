{
  "name": "@ubean/prerender",
  "version": "0.1.8",
  "description": "SSG prerendering for ubean (prerender, collectPrerenderRoutes, definePrerenderRoutes)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/config": "workspace:*",
    "@ubean/routing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "pathe": "^2.0.3",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  }
}
