{
  "name": "@ubean/routes",
  "version": "0.3.5",
  "description": "Server routes runtime for ubean (defineHandler, defineMiddleware, registerRoutes, Server Actions, rou3 server router, route rules, ISR, internal-fetch, OpenAPI)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@soybeanjs/fetch": "^0.1.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@ubean/i18n": "workspace:*",
    "@ubean/shared": "workspace:*",
    "hono": "4.13.5",
    "hono-openapi": "^1.3.1",
    "rou3": "^0.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@ubean/pages": "workspace:*",
    "@ubean/scan": "workspace:*",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "@ubean/pages": "workspace:*",
    "@ubean/scan": "workspace:*",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@ubean/scan": {
      "optional": true
    },
    "@ubean/pages": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
