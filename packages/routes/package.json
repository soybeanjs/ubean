{
  "name": "@ubean/routes",
  "version": "0.6.1-beta.1",
  "description": "Server routes runtime for ubean (defineHandler, defineMiddleware, registerRoutes, Server Actions, rou3 server router, route rules, ISR, internal-fetch, OpenAPI)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@soybeanjs/fetch": "^0.1.0",
    "@ubean/i18n": "workspace:*",
    "@ubean/shared": "workspace:*",
    "hono": "4.13.13",
    "hono-openapi": "^1.3.5",
    "rou3": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@ubean/pages": "workspace:*",
    "@ubean/scan": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@ubean/pages": "workspace:*",
    "@ubean/scan": "workspace:*",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@ubean/scan": {
      "optional": true
    },
    "@ubean/pages": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
