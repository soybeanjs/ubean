{
  "name": "@ubean/routing",
  "version": "0.1.13",
  "description": "File-based routing core for ubean (scanner, rou3 matcher, route name generator, define-page AST extractor, file generator)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/types": "workspace:*",
    "@ubean/utils": "workspace:*",
    "consola": "^3.4.2",
    "pathe": "^2.0.3",
    "rou3": "^0.9.1",
    "scule": "^1.3.0",
    "tinyglobby": "^0.2.17",
    "ufo": "1.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@ubean/markdown": "workspace:*",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "@ubean/markdown": "workspace:*",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ubean/markdown": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  }
}
