{
  "name": "@ubean/runtime",
  "version": "0.1.13",
  "description": "Vue client runtime for ubean (createUbeanVueApp, createUbeanSSRApp, useRouter, useHead, Link, Head, PageView, composables, view-transitions, cache-views, islands hydrate)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./define-app": {
      "types": "./dist/define-app.d.ts",
      "import": "./dist/define-app.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/i18n": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/pages": "workspace:*",
    "@ubean/types": "workspace:*",
    "@unhead/vue": "^3.3.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ubean/routing": "workspace:*",
    "@ubean/seo": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ubean/seo": {
      "optional": true
    },
    "@ubean/routing": {
      "optional": true
    }
  }
}
