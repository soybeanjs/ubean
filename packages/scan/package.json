{
  "name": "@ubean/scan",
  "version": "0.2.2",
  "description": "Project scanner & route metadata for ubean — server-side directory scanning (API routes, middleware, plugins, crons, queues, locales, entries) plus page scanning delegated to @ubean/vue",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/shared": "workspace:*",
    "@ubean/vue": "workspace:*",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@ubean/markdown": "workspace:*",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  }
}
