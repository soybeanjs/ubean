{
  "name": "@ubean/seo",
  "version": "0.2.2",
  "description": "SEO utilities for ubean (useSeoMeta, robots, sitemap, manifest, file conventions, JSON-LD, OG image)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conventions": {
      "types": "./dist/conventions.d.ts",
      "import": "./dist/conventions.js"
    },
    "./og-image": {
      "types": "./dist/og-image.d.ts",
      "import": "./dist/og-image.js"
    },
    "./json-ld": {
      "types": "./dist/json-ld.d.ts",
      "import": "./dist/json-ld.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@unhead/vue": "^3.3.2",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.0",
    "satori": "^0.12.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "satori": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    }
  }
}
