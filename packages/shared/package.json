{
  "name": "@ubean/shared",
  "version": "0.2.0",
  "description": "Shared protocol types, errors, env and universal utilities for ubean",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "hono": "4.13.3",
    "pathe": "^2.0.3",
    "scule": "^1.3.0",
    "ufo": "1.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  }
}
