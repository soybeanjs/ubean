{
  "name": "@ubean/pwa",
  "version": "0.0.1",
  "description": "PWA module for ubean with Service Worker and Web App Manifest",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "consola": "catalog:",
    "defu": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.39"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "optionalDependencies": {}
}
