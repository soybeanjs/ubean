{
  "name": "ubean",
  "version": "0.1.5",
  "description": "Vue-first full-stack meta-framework built on Vite-Plus with Hono (aggregator of all @ubean/* subpackages)",
  "bin": {
    "ubean": "./bin/ubean.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./vue-ssr": {
      "types": "./dist/vue-ssr.d.ts",
      "import": "./dist/vue-ssr.js"
    },
    "./runtime/vue": {
      "types": "./dist/runtime/vue.d.ts",
      "import": "./dist/runtime/vue.js"
    },
    "./runtime/app": {
      "types": "./dist/runtime/app.d.ts",
      "import": "./dist/runtime/app.js"
    },
    "./runtime/i18n": {
      "types": "./dist/runtime/i18n.d.ts",
      "import": "./dist/runtime/i18n.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.3.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@ubean/api-routes": "workspace:*",
    "@ubean/app": "workspace:*",
    "@ubean/auto-imports": "workspace:*",
    "@ubean/build": "workspace:*",
    "@ubean/cli": "workspace:*",
    "@ubean/codegen": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/dev-server": "workspace:*",
    "@ubean/devtools": "workspace:*",
    "@ubean/env": "workspace:*",
    "@ubean/error": "workspace:*",
    "@ubean/i18n": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/markdown": "workspace:*",
    "@ubean/modules": "workspace:*",
    "@ubean/pages": "workspace:*",
    "@ubean/prerender": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/routing": "workspace:*",
    "@ubean/runtime": "workspace:*",
    "@ubean/seo": "workspace:*",
    "@ubean/server": "workspace:*",
    "@ubean/ssr": "workspace:*",
    "@ubean/types": "workspace:*",
    "@ubean/utils": "workspace:*",
    "@ubean/vite": "workspace:*",
    "consola": "^3.4.2",
    "hono": "4.12.32",
    "hono-openapi": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
