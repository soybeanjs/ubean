{
  "name": "ubean",
  "version": "0.3.3",
  "description": "Vue-first full-stack meta-framework built on Vite-Plus with Hono (aggregator of all @ubean/* subpackages)",
  "bin": {
    "ubean": "./bin/ubean.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./vue-ssr": {
      "types": "./dist/vue-ssr.d.ts",
      "import": "./dist/vue-ssr.js"
    },
    "./runtime/vue": {
      "types": "./dist/runtime/vue.d.ts",
      "import": "./dist/runtime/vue.js"
    },
    "./runtime/app": {
      "types": "./dist/runtime/app.d.ts",
      "import": "./dist/runtime/app.js"
    },
    "./runtime/i18n": {
      "types": "./dist/runtime/i18n.d.ts",
      "import": "./dist/runtime/i18n.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@ubean/app": "workspace:*",
    "@ubean/build": "workspace:*",
    "@ubean/cli": "workspace:*",
    "@ubean/client": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/i18n": "workspace:*",
    "@ubean/integrations": "workspace:*",
    "@ubean/islands": "workspace:*",
    "@ubean/markdown": "workspace:*",
    "@ubean/pages": "workspace:*",
    "@ubean/preset": "workspace:*",
    "@ubean/routes": "workspace:*",
    "@ubean/scan": "workspace:*",
    "@ubean/seo": "workspace:*",
    "@ubean/server": "workspace:*",
    "@ubean/shared": "workspace:*",
    "hono": "4.13.5",
    "hono-openapi": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
