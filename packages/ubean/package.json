{
  "name": "ubean",
  "version": "1.0.0",
  "description": "Vue meta framework built on Vite-Plus with Hono (thin re-export of @ubean/core)",
  "bin": {
    "ubean": "./bin/ubean.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/runtime/vue/index.mjs",
      "import": "./dist/index.mjs"
    },
    "./handler": {
      "types": "./dist/runtime/handler.d.mts",
      "import": "./dist/runtime/handler.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./vite-vue": {
      "types": "./dist/vite-vue.d.mts",
      "import": "./dist/vite-vue.mjs"
    },
    "./vue-ssr": {
      "types": "./dist/vue-ssr.d.mts",
      "import": "./dist/vue-ssr.mjs"
    },
    "./routing": {
      "types": "./dist/routing.d.mts",
      "import": "./dist/routing.mjs"
    },
    "./pages": {
      "types": "./dist/pages.d.mts",
      "import": "./dist/pages.mjs"
    },
    "./runtime/app": {
      "types": "./dist/runtime/app.d.mts",
      "import": "./dist/runtime/app.mjs"
    },
    "./runtime/define-server": {
      "types": "./dist/runtime/define-server.d.mts",
      "import": "./dist/runtime/define-server.mjs"
    },
    "./runtime/handler": {
      "types": "./dist/runtime/handler.d.mts",
      "import": "./dist/runtime/handler.mjs"
    },
    "./runtime/vue": {
      "types": "./dist/runtime/vue/index.d.mts",
      "browser": "./dist/runtime/vue/index.mjs",
      "import": "./dist/runtime/vue/index.mjs"
    },
    "./runtime/i18n": {
      "types": "./dist/runtime/i18n.d.mts",
      "import": "./dist/runtime/i18n.mjs"
    },
    "./runtime/i18n-routing": {
      "types": "./dist/runtime/i18n-routing.d.mts",
      "import": "./dist/runtime/i18n-routing.mjs"
    },
    "./vue-runtime": {
      "types": "./dist/vue-runtime.d.mts",
      "import": "./dist/vue-runtime.mjs"
    },
    "./vue-runtime/app": {
      "types": "./dist/vue-runtime/app.d.mts",
      "import": "./dist/vue-runtime/app.mjs"
    },
    "./vue-runtime/define-app": {
      "types": "./dist/vue-runtime/define-app.d.mts",
      "import": "./dist/vue-runtime/define-app.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ubean/api-routes": "workspace:*",
    "@ubean/app": "workspace:*",
    "@ubean/build": "workspace:*",
    "@ubean/cli": "workspace:*",
    "@ubean/config": "workspace:*",
    "@ubean/core": "workspace:*",
    "@ubean/env": "workspace:*",
    "@ubean/error": "workspace:*",
    "@ubean/i18n": "workspace:*",
    "@ubean/pages": "workspace:*",
    "@ubean/routing": "workspace:*",
    "@ubean/runtime": "workspace:*",
    "@ubean/ssr": "workspace:*",
    "@ubean/vite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
