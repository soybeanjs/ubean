{
  "name": "@ubean/utils",
  "version": "0.1.4",
  "description": "Shared utilities for ubean (path conversion, port detection, vite config)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
