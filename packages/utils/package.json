  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17",
    "ufo": "1.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "6.0.3",
    "vite-plus": "catalog:"
  }
}
